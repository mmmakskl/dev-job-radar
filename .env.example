# Telegram API credentials from https://my.telegram.org/apps
API_ID=
API_HASH=
SESSION_NAME=my_account
# Optional locally; Compose sets DATA_DIR=/app/data.
# DATA_DIR=/app/data
# SESSION_PATH=/app/data/my_account

# Comma-separated public usernames or numeric channel IDs
TARGET_CHANNELS=devs_it,job_for_programmers
# Telegram folder whose channels/groups are periodically appended to TARGET_CHANNELS
TELEGRAM_CHANNELS_FOLDER=Вакансии

# Mistral API token from https://console.mistral.ai/
MISTRAL_API_KEY=

# URL of a Google Sheet shared with the service account from credentials.json
GOOGLE_SHEET_URL=
GOOGLE_CREDENTIALS_PATH=credentials.json
OUTPUT_TIMEZONE=Europe/Moscow
GOOGLE_SHEET_FULL_TITLE=Вакансии — полные
GOOGLE_SHEET_SHORT_TITLE=Вакансии — кратко

# Append-only JSONL deduplication state and text hash TTL
STATE_FILE_PATH=data/state.jsonl
TEXT_HASH_TTL_DAYS=30

# Live listener queue (1 worker is recommended for sequential processing)
LIVE_QUEUE_MAXSIZE=1000
LIVE_WORKERS=1

# Telegram notifications for matching vacancies
TELEGRAM_NOTIFY_ENABLED=false
TELEGRAM_NOTIFY_TARGET=@your_private_or_public_channel
TELEGRAM_NOTIFY_HISTORY=false

# Optional private beta candidate interface. This is a separate Bot API token,
# never the Telethon userbot session. The bot uses long polling; no domain is needed.
CANDIDATE_BOT_ENABLED=false
CANDIDATE_BOT_TOKEN=
# Shared channel/group where this Bot API bot is an administrator.
CANDIDATE_BOT_CHANNEL=@your_beta_vacancies_channel
# Comma-separated numeric Telegram user IDs. Empty means nobody is admitted.
CANDIDATE_BOT_ALLOWED_USER_IDS=
# Defaults to data/candidate_bot.sqlite3 (or /app/data/candidate_bot.sqlite3 in Compose).
# CANDIDATE_BOT_DB_PATH=data/candidate_bot.sqlite3

# Local admin panel. Never commit a production value for these secrets.
# Generate ADMIN_SESSION_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# false is safe only for the default localhost binding accessed through SSH tunnel.
# Set true behind HTTPS.
ADMIN_COOKIE_SECURE=false

# Observability retention and operational alert policy are saved through the
# admin panel in data/admin/settings.json, not in this file. Alerts use the
# existing Telegram notification target and are disabled by default.
